#!/bin/sh
# push 前に、テストと文書の機械検査を走らせる。
#
# 実行順序は「検査自身の回帰テスト → 本番検査」。本番検査を先にすると、
# 落ちた瞬間に判定器がまともかどうかを確かめる手段を同時に失う。
#
# スキップ判定は検査の単位ごとに行う。まとめて 1 つの条件にすると、
# 文書検査に無関係な依存が欠けただけで文書検査まで黙って飛ぶ——
# docs/knowledge/ci-and-checks.md が禁じている fail-open になる。
#
# 導入: scripts/install-git-hooks.sh
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# 依存の有無は「どの python でその依存を import できるか」で決める。
# .venv の存在だけで分岐すると、.venv はあるが当該モジュールが無い環境で
# 理由不明に落ちたり、逆に理由を取り違えた skip 表示になったりする。
py_with() {
    for py in .venv/bin/python python3; do
        if "$py" -c "import $1" >/dev/null 2>&1; then
            echo "$py"
            return 0
        fi
    done
    return 1
}

echo "==> pytest"
if PY=$(py_with pytest); then
    "$PY" -m pytest tests -q
else
    echo "    skip: pytest を import できる python が無い（CI が担保する）"
fi

# 出力を捨てると失敗の理由が分からなくなる。成功時だけ要約に畳む。
quiet_run() {
    out=$(mktemp)
    if "$@" >"$out" 2>&1; then
        tail -n 1 "$out"
        rm -f "$out"
    else
        cat "$out"
        rm -f "$out"
        return 1
    fi
}

if command -v python3 >/dev/null 2>&1; then
    echo "==> 検査スクリプト自身の回帰テスト"
    quiet_run python3 scripts/test-check-doc-classes.py
    quiet_run python3 scripts/test-check-decision-log-immutability.py
    quiet_run python3 scripts/test-check-no-pdf-committed.py
    quiet_run python3 scripts/test-pre-push-skip-isolation.py

    echo "==> 文書の機械検査"
    python3 scripts/check-doc-classes.py
    python3 scripts/check-decision-log-immutability.py
    python3 scripts/check-no-pdf-committed.py
else
    echo "==> 文書の機械検査 skip: python3 が無い（CI が担保する）"
fi

# 評価計測は reportlab（合成コーパスの生成）に依存するので、判定を分ける。
if PY=$(py_with reportlab); then
    if [ -f scripts/eval-golden.py ]; then
        echo "==> ゴールデンクエリの回帰計測"
        "$PY" scripts/eval-golden.py --set all --check-baseline
    else
        # 飛ばしたことを黙らせない。スクリプトの改名・削除で計測が消えても
        # 気づけなくなる。
        echo "==> 評価計測 skip: scripts/eval-golden.py が無い"
    fi
else
    echo "==> 評価計測 skip: reportlab を import できる python が無い（CI が担保する）"
fi

echo "==> OK"
